# ---- Visaroo backend configuration ----

# App
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./visaroo.db

# AI provider: "local" (default, no AWS needed) or "bedrock"
AI_PROVIDER=local

# AWS Bedrock (only used when AI_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_TEXT_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# AWS credentials are read from the standard AWS chain (env, profile, role).

# Crypto provider for sensitive profile fields: "local" (Fernet, default) or "kms" (AWS KMS)
CRYPTO_PROVIDER=local
# Required when CRYPTO_PROVIDER=kms — a KMS key id, ARN, or alias (e.g. alias/visaroo-profiles)
KMS_KEY_ID=
# Optional base64 Fernet key for the local provider. If empty, a dev key is derived
# from SECRET_KEY so the app runs out of the box. Set a real key in production.
FERNET_KEY=

# Email for deadline reminders: "local" (log preview, default) or "ses" (Amazon SES)
EMAIL_PROVIDER=local
# Required when EMAIL_PROVIDER=ses — a verified SES sender identity
SES_FROM_EMAIL=

# CORS (frontend dev origin)
FRONTEND_ORIGIN=http://localhost:5173
